# Copy to apps/web/.env.local and fill in. Only PUBLIC values go in the browser.
# Secret values (LLM key, secret API key, Turnstile secret) are NEVER put in a file in this repo:
# set them in Supabase with:  npx supabase secrets set NAME=value
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set to true only after Google sign-in is switched on in Supabase (it needs a Google OAuth client).
# Until then the login page shows no Google button.
NEXT_PUBLIC_GOOGLE_ENABLED=false
# Set to true only after the branded sign-in emails (with the 6-digit code) are live: run
# scripts/apply-email-settings.sh. Until then Supabase's own email has a link and no code, and the login page
# asks people to open the link.
NEXT_PUBLIC_EMAIL_CODE=false
