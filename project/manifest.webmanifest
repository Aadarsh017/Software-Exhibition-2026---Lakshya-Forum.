{
  "name": "Health Chat Helper",
  "short_name": "Health Chat",
  "description": "A general health advice chatbot with guided questions, safety reminders, and offline support.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef4f1",
  "theme_color": "#126b63",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ask About Fever",
      "short_name": "Fever",
      "description": "Start with a fever question.",
      "url": "./index.html?topic=fever"
    },
    {
      "name": "Ask About Stomach Pain",
      "short_name": "Stomach",
      "description": "Start with a stomach symptom question.",
      "url": "./index.html?topic=stomach"
    },
    {
      "name": "Open Dashboard",
      "short_name": "Dashboard",
      "description": "View locally stored health chat records.",
      "url": "./dashboard.html"
    }
  ]
}